{
  "collectionName": "components_shared_cta_buttons",
  "info": {
    "displayName": "CTA Button",
    "description": "Call-to-action button component"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 500
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "primary",
        "secondary",
        "outline",
        "ghost"
      ],
      "default": "primary",
      "required": true
    },
    "icon": {
      "type": "string",
      "required": false,
      "maxLength": 50
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "size": {
      "type": "enumeration",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium"
    },
    "isDisabled": {
      "type": "boolean",
      "default": false
    }
  }
}