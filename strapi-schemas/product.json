{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Cannabis products for the carousel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "brand": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["flower", "edibles", "concentrates", "pre-rolls", "vapes", "topicals", "accessories"],
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "thc": {
      "type": "string",
      "required": false
    },
    "cbd": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "badge": {
      "type": "enumeration",
      "enum": ["new", "sale", "limited", "bestseller", "exclusive"],
      "required": false
    },
    "discount": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "required": false
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
